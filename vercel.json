{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "data/products.json"
    }
  },
  "rewrites": [
    { "source": "/catalogo", "destination": "/catalogo.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
